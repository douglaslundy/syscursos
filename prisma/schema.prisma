generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  PRODUCER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CourseStatus {
  ACTIVE
  INACTIVE
}

enum ModuleStatus {
  ACTIVE
  INACTIVE
}

enum LessonStatus {
  ACTIVE
  INACTIVE
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum LessonProgressStatus {
  NOT_STARTED
  COMPLETED
}

model User {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  authUserId     String?         @unique @map("auth_user_id") @db.Uuid
  email          String          @unique @db.VarChar(255)
  name           String          @db.VarChar(160)
  role           UserRole
  status         UserStatus      @default(ACTIVE)
  accessExpiresAt DateTime?      @map("access_expires_at") @db.Timestamptz(6)
  lastLoginAt    DateTime?       @map("last_login_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile?
  producedCourses Course[]       @relation("CourseProducer")
  producerStudents ProducerStudent[] @relation("ProducerStudentProducer")

  @@index([organizationId, role, status])
  @@map("users")
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(180)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  users     User[]
  courses   Course[]

  @@map("organizations")
}

model StudentProfile {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @unique @map("user_id") @db.Uuid
  document    String?          @unique @db.VarChar(32)
  phone       String?          @db.VarChar(32)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  notes       LessonNote[]
  progress    LessonProgress[]
  producers   ProducerStudent[]  @relation("ProducerStudentStudent")

  @@map("student_profiles")
}

model Course {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  producerId  String       @map("producer_id") @db.Uuid
  title       String       @db.VarChar(180)
  slug        String       @unique @db.VarChar(200)
  description String?
  coverImageUrl String?    @map("cover_image_url") @db.VarChar(500)
  status      CourseStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  producer    User         @relation("CourseProducer", fields: [producerId], references: [id], onDelete: Restrict)
  modules     Module[]
  enrollments Enrollment[]

  @@index([organizationId, producerId, status])
  @@index([title])
  @@map("courses")
}

model ProducerStudent {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  producerId  String         @map("producer_id") @db.Uuid
  studentId   String         @map("student_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  producer    User           @relation("ProducerStudentProducer", fields: [producerId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation("ProducerStudentStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([producerId, studentId])
  @@index([studentId])
  @@map("producer_students")
}

model Module {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId    String       @map("course_id") @db.Uuid
  title       String       @db.VarChar(180)
  description String?
  coverImageUrl String?    @map("cover_image_url") @db.VarChar(500)
  position    Int
  status      ModuleStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([courseId, position])
  @@index([courseId, status])
  @@map("modules")
}

model Lesson {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId       String           @map("module_id") @db.Uuid
  title          String           @db.VarChar(180)
  description    String?
  youtubeUrl     String           @map("youtube_url") @db.VarChar(500)
  youtubeVideoId String?          @map("youtube_video_id") @db.VarChar(32)
  position       Int
  status         LessonStatus     @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  module         Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  notes          LessonNote[]
  progress       LessonProgress[]

  @@unique([moduleId, position])
  @@index([moduleId, status])
  @@index([youtubeVideoId])
  @@map("lessons")
}

model Enrollment {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  courseId  String           @map("course_id") @db.Uuid
  startsAt  DateTime         @map("starts_at") @db.Timestamptz(6)
  expiresAt DateTime?        @map("expires_at") @db.Timestamptz(6)
  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId, status])
  @@index([studentId, status])
  @@index([expiresAt])
  @@map("enrollments")
}

model LessonNote {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String         @map("student_id") @db.Uuid
  lessonId  String         @map("lesson_id") @db.Uuid
  content   String
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([lessonId])
  @@map("lesson_notes")
}

model LessonProgress {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId   String               @map("student_id") @db.Uuid
  lessonId    String               @map("lesson_id") @db.Uuid
  status      LessonProgressStatus @default(NOT_STARTED)
  completedAt DateTime?            @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  student     StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson      Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([lessonId])
  @@index([studentId, status])
  @@map("lesson_progress")
}
