generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  PRODUCER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CourseStatus {
  ACTIVE
  INACTIVE
}

enum ModuleStatus {
  ACTIVE
  INACTIVE
}

enum LessonStatus {
  ACTIVE
  INACTIVE
}

enum LessonMaterialType {
  PDF
  LINK
}

enum LessonMaterialStatus {
  ACTIVE
  INACTIVE
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum EnrollmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LessonProgressStatus {
  NOT_STARTED
  COMPLETED
}

model User {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  authUserId       String?           @unique @map("auth_user_id") @db.Uuid
  email            String            @unique @db.VarChar(255)
  name             String            @db.VarChar(160)
  role             UserRole
  status           UserStatus        @default(ACTIVE)
  accessExpiresAt  DateTime?         @map("access_expires_at") @db.Timestamptz(6)
  lastLoginAt      DateTime?         @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile?
  producedCourses  Course[]          @relation("CourseProducer")
  producerStudents ProducerStudent[] @relation("ProducerStudentProducer")
  notifications    Notification[]

  @@index([organizationId, role, status])
  @@map("users")
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(180)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  users     User[]
  courses   Course[]

  @@map("organizations")
}

model StudentProfile {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String              @unique @map("user_id") @db.Uuid
  document           String?             @unique @db.VarChar(32)
  phone              String?             @db.VarChar(32)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments        Enrollment[]
  notes              LessonNote[]
  progress           LessonProgress[]
  enrollmentRequests EnrollmentRequest[]
  favoriteCourses    FavoriteCourse[]
  favoriteLessons    FavoriteLesson[]
  studyPlans         StudyPlan[]
  studySchedule      StudySchedule?
  aiUsages           AiUsage[]
  quizAttempts       QuizAttempt[]
  flashcardReviews   FlashcardReview[]
  bookmarks          LessonBookmark[]
  studyDays          StudyDay[]
  certificates       Certificate[]
  questions          LessonQuestion[]
  playlists          Playlist[]
  weeklyGoalMinutes  Int                 @default(0) @map("weekly_goal_minutes")
  // WhatsApp vinculado ao agente (OpenClaw). O codigo de vinculo e guardado so como hash e vale por poucos minutos.
  whatsappPhone         String?   @unique @map("whatsapp_phone") @db.VarChar(20)
  whatsappCodeHash      String?   @unique @map("whatsapp_code_hash") @db.VarChar(64)
  whatsappCodeExpiresAt DateTime? @map("whatsapp_code_expires_at") @db.Timestamptz(6)
  playbackRate       Float               @default(1) @map("playback_rate")
  studyWeekdays      Int[]               @default([1, 2, 3, 4, 5]) @map("study_weekdays")
  studyStartMinute   Int                 @default(1140) @map("study_start_minute")
  studyEndMinute     Int                 @default(1260) @map("study_end_minute")
  producers          ProducerStudent[]   @relation("ProducerStudentStudent")

  @@map("student_profiles")
}

model Course {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  producerId         String              @map("producer_id") @db.Uuid
  title              String              @db.VarChar(180)
  slug               String              @unique @db.VarChar(200)
  description        String?
  coverImageUrl      String?             @map("cover_image_url") @db.VarChar(500)
  status             CourseStatus        @default(ACTIVE)
  isPublic           Boolean             @default(false) @map("is_public")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  producer           User                @relation("CourseProducer", fields: [producerId], references: [id], onDelete: Restrict)
  modules            Module[]
  enrollments        Enrollment[]
  enrollmentRequests EnrollmentRequest[]
  favorites          FavoriteCourse[]
  studyPlans         StudyPlan[]
  aiUsages           AiUsage[]
  quizAttempts       QuizAttempt[]
  exam               CourseExam?
  certificates       Certificate[]
  questions          LessonQuestion[]

  @@index([organizationId, producerId, status])
  @@index([isPublic, status])
  @@index([title])
  @@map("courses")
}

model ProducerStudent {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  producerId String         @map("producer_id") @db.Uuid
  studentId  String         @map("student_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  producer   User           @relation("ProducerStudentProducer", fields: [producerId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation("ProducerStudentStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([producerId, studentId])
  @@index([studentId])
  @@map("producer_students")
}

model Module {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId    String       @map("course_id") @db.Uuid
  title       String       @db.VarChar(180)
  description String?
  position    Int
  status      ModuleStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([courseId, position])
  @@index([courseId, status])
  @@map("modules")
}

model Lesson {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId           String            @map("module_id") @db.Uuid
  title              String            @db.VarChar(180)
  description        String?
  youtubeUrl         String            @map("youtube_url") @db.VarChar(500)
  youtubeVideoId     String?           @map("youtube_video_id") @db.VarChar(32)
  coverImageUrl      String?           @map("cover_image_url") @db.VarChar(500)
  position           Int
  durationSeconds    Int?              @map("duration_seconds")
  transcript         String?           @db.Text
  transcriptAuthorId String?           @map("transcript_author_id") @db.Uuid
  status             LessonStatus      @default(ACTIVE)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  module             Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  notes              LessonNote[]
  progress           LessonProgress[]
  materials          LessonMaterial[]
  favorites          FavoriteLesson[]
  aiContents         LessonAiContent[]
  quizAttempts       QuizAttempt[]
  flashcardReviews   FlashcardReview[]
  bookmarks          LessonBookmark[]
  questions          LessonQuestion[]
  playlistItems      PlaylistItem[]

  @@unique([moduleId, position])
  @@index([moduleId, status])
  @@index([youtubeVideoId])
  @@map("lessons")
}

model LessonMaterial {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId  String               @map("lesson_id") @db.Uuid
  type      LessonMaterialType   @map("material_type")
  title     String               @db.VarChar(180)
  url       String               @db.VarChar(500)
  position  Int
  status    LessonMaterialStatus @default(ACTIVE)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  lesson    Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, position])
  @@index([lessonId, status])
  @@map("lesson_materials")
}

model Enrollment {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  courseId  String           @map("course_id") @db.Uuid
  startsAt  DateTime         @map("starts_at") @db.Timestamptz(6)
  expiresAt DateTime?        @map("expires_at") @db.Timestamptz(6)
  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId, status])
  @@index([studentId, status])
  @@index([expiresAt])
  @@map("enrollments")
}

model EnrollmentRequest {
  id         String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String                  @map("student_id") @db.Uuid
  courseId   String                  @map("course_id") @db.Uuid
  status     EnrollmentRequestStatus @default(PENDING)
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime?               @map("resolved_at") @db.Timestamptz(6)
  student    StudentProfile          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course     Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId, status])
  @@map("enrollment_requests")
}

model FavoriteCourse {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String         @map("student_id") @db.Uuid
  courseId  String         @map("course_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@map("favorite_courses")
}

model FavoriteLesson {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String         @map("student_id") @db.Uuid
  lessonId  String         @map("lesson_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@map("favorite_lessons")
}

model LessonNote {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String         @map("student_id") @db.Uuid
  lessonId  String         @map("lesson_id") @db.Uuid
  content   String
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([lessonId])
  @@map("lesson_notes")
}

model LessonProgress {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId       String               @map("student_id") @db.Uuid
  lessonId        String               @map("lesson_id") @db.Uuid
  status          LessonProgressStatus @default(NOT_STARTED)
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz(6)
  positionSeconds Int                  @default(0) @map("position_seconds")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  student         StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson          Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([lessonId])
  @@index([studentId, status])
  @@map("lesson_progress")
}

model StudyPlan {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId    String         @map("student_id") @db.Uuid
  courseId     String         @map("course_id") @db.Uuid
  targetDate   DateTime       @map("target_date") @db.Date
  dailyMinutes Int            @map("daily_minutes")
  schedule     Json           @default("[]")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@map("study_plans")
}

// Cronograma unico do aluno com ate 5 cursos; o calendario fica em `schedule` e e remontado com os dados atuais a cada acesso.
model StudySchedule {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId    String         @unique @map("student_id") @db.Uuid
  courseIds    String[]       @map("course_ids") @db.Uuid
  courseModes  Json           @default("{}") @map("course_modes")
  blockedRanges Json          @default("[]") @map("blocked_ranges")
  targetDate  DateTime       @map("target_date") @db.Date
  dailyMinutes Int            @map("daily_minutes")
  schedule     Json           @default("[]")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("study_schedules")
}

model AppSetting {
  key       String   @id @db.VarChar(80)
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

enum AiContentKind {
  SUMMARY
  FLASHCARDS
  MINDMAP
  QUIZ
  EXAM
  CHAT
}

// Resumo, flashcards ou mapa mental gerado por IA: um por (aula, tipo, tecnica) e reaproveitado por todos os alunos.
model LessonAiContent {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId    String        @map("lesson_id") @db.Uuid
  kind        AiContentKind
  technique   String        @default("") @db.VarChar(32)
  content     String        @db.Text
  provider    String        @db.VarChar(20)
  model       String        @db.VarChar(60)
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  lesson      Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, kind, technique])
  @@map("lesson_ai_contents")
}

// Uma linha por chamada a IA, para o painel de consumo de tokens.
model AiUsage {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider     String          @db.VarChar(20)
  model        String          @db.VarChar(60)
  kind         AiContentKind
  inputTokens  Int             @map("input_tokens")
  outputTokens Int             @map("output_tokens")
  studentId    String?         @map("student_id") @db.Uuid
  courseId     String?         @map("course_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  student      StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  course       Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([courseId])
  @@index([studentId])
  @@map("ai_usage_logs")
}

// --- Recursos de estudo (quiz, revisao espacada, marcadores, metas, certificado, duvidas, trilhas, auditoria) ---

// Tentativa de quiz: de uma aula (lessonId) ou da prova final do curso (courseId). O quiz em si fica em LessonAiContent/CourseExam.
model QuizAttempt {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String         @map("student_id") @db.Uuid
  lessonId  String?        @map("lesson_id") @db.Uuid
  courseId  String?        @map("course_id") @db.Uuid
  score     Int
  total     Int
  answers   Json           @default("[]")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson    Lesson?        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course    Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentId, lessonId])
  @@index([studentId, courseId])
  @@index([lessonId])
  @@map("quiz_attempts")
}

// Prova final do curso gerada por IA uma unica vez e usada por todos os alunos.
model CourseExam {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId    String   @unique @map("course_id") @db.Uuid
  content     String   @db.Text
  provider    String   @db.VarChar(20)
  model       String   @db.VarChar(60)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_exams")
}

// Agenda de revisao de um flashcard (algoritmo SM-2 simplificado). cardKey identifica o cartao dentro da aula.
model FlashcardReview {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String         @map("student_id") @db.Uuid
  lessonId       String         @map("lesson_id") @db.Uuid
  cardKey        String         @map("card_key") @db.VarChar(64)
  ease           Float          @default(2.5)
  intervalDays   Int            @default(0) @map("interval_days")
  reps           Int            @default(0)
  lapses         Int            @default(0)
  dueAt          DateTime       @default(now()) @map("due_at") @db.Timestamptz(6)
  lastReviewedAt DateTime?      @map("last_reviewed_at") @db.Timestamptz(6)
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson         Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId, cardKey])
  @@index([studentId, dueAt])
  @@map("flashcard_reviews")
}

// Marcador de um minuto do video com texto do aluno.
model LessonBookmark {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String         @map("student_id") @db.Uuid
  lessonId  String         @map("lesson_id") @db.Uuid
  seconds   Int
  label     String         @db.VarChar(200)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([studentId, lessonId])
  @@map("lesson_bookmarks")
}

// Tempo estudado por dia (base de sequencia, meta semanal e metricas).
model StudyDay {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String         @map("student_id") @db.Uuid
  day       DateTime       @db.Date
  seconds   Int            @default(0)
  lessons   Int            @default(0)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, day])
  @@map("study_days")
}

model Certificate {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String         @map("student_id") @db.Uuid
  courseId  String         @map("course_id") @db.Uuid
  code      String         @unique @db.VarChar(24)
  issuedAt  DateTime       @default(now()) @map("issued_at") @db.Timestamptz(6)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@map("certificates")
}

// Duvida do aluno numa aula; o produtor do curso (ou admin) responde.
model LessonQuestion {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId     String         @map("lesson_id") @db.Uuid
  courseId     String         @map("course_id") @db.Uuid
  studentId    String         @map("student_id") @db.Uuid
  body         String         @db.VarChar(2000)
  answer       String?        @db.VarChar(4000)
  answeredById String?        @map("answered_by_id") @db.Uuid
  answeredAt   DateTime?      @map("answered_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([lessonId, createdAt])
  @@index([courseId, answeredAt])
  @@index([studentId])
  @@map("lesson_questions")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String    @db.VarChar(30)
  title     String    @db.VarChar(200)
  href      String?   @db.VarChar(300)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Playlist {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String         @map("student_id") @db.Uuid
  name      String         @db.VarChar(120)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items     PlaylistItem[]

  @@index([studentId])
  @@map("playlists")
}

model PlaylistItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playlistId String   @map("playlist_id") @db.Uuid
  lessonId   String   @map("lesson_id") @db.Uuid
  position   Int
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([playlistId, lessonId])
  @@index([playlistId, position])
  @@map("playlist_items")
}

// Registro das acoes sensiveis do painel (quem fez o que, quando).
model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  actorRole String?  @map("actor_role") @db.VarChar(20)
  action    String   @db.VarChar(60)
  entity    String   @db.VarChar(40)
  entityId  String?  @map("entity_id") @db.VarChar(80)
  meta      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

// Tentativas de login/cadastro, para o limite valer em todas as instancias (ver server/security/rate-limit.ts).
model RateLimitEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([key, createdAt])
  @@map("rate_limit_events")
}
